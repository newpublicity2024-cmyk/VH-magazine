legacy-peer-deps=true
# This machine's link to the npm registry runs at tens of KiB/s; the stock
# 60s metadata timeout aborts mid-install. Raised so a slow link retries
# rather than failing the whole tree.
fetch-timeout=1200000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
network-concurrency=6
