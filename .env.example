# ─────────────────────────────────────────────────────────────
# VH Magazine — environment variables
# Copy to `.env` for local dev. In production these live ONLY in Vercel env.
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Payload owns the schema).
# Local dev: a Homebrew postgresql@17 database, no SSL.
# Production: Neon — append ?sslmode=verify-full (the config upgrades
# require/prefer/verify-ca to verify-full to avoid the pg deprecation warning).
DATABASE_URL=postgres://localhost/vh_magazine

# Payload encryption secret (generate a long random string).
PAYLOAD_SECRET=

# Public site URL — canonical URLs, OpenGraph, sitemaps, preview.
# Must have NO trailing slash; routes.ts adds it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media: Vercel Blob (set at deploy time; unset ⇒ local disk under /media) ──
# BLOB_READ_WRITE_TOKEN=

# ── Secret-protected on-demand revalidation (step 7) ──
# REVALIDATE_SECRET=

# ── Round 2a: legacy media (amendment B1) ──
# Upstream for /wp-content/uploads/* during the validation window. Never hardcode a host.
MEDIA_ORIGIN=https://www.vh.ma
